{
    "name": "wri/wri_sites",
    "description": "WRI Drupal 8 profile",
    "type": "drupal-profile",
    "license": "GPL-2.0+",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "extra": {
        "patches": {
            "drupal/address": {
                "AddressFieldBuilder::build() needs an array return type for diff 2.x https://www.drupal.org/project/address/issues/3460590 (committed to 2.0.x, not released)": "https://git.drupalcode.org/project/address/-/commit/ba10f2ea735dc6f64e500a203116b4e897be37e1.diff"
            },
            "drupal/core": {
                "Dynamic Views Arguments via Tokens https://www.drupal.org/project/drupal/issues/1699378": "https://git.drupalcode.org/project/drupal/-/merge_requests/9935.diff",
                "Add reusable option to inline block creation https://www.drupal.org/project/drupal/issues/2999491": "https://raw.githubusercontent.com/wri/wri_sites/refs/heads/624-d11-upgrade/patches/core--reusable-option-inline-block-creation--2999491-d11.patch",
                "Hyphens and forward slashes (-/) break Views contextual filters https://www.drupal.org/node/672606": "https://raw.githubusercontent.com/wri/wri_sites/refs/heads/624-d11-upgrade/patches/core--views-contextual-filters-hyphens-slashes--672606-d11.patch",
                "Views RSS feeds have validation issues https://www.drupal.org/project/drupal/issues/1337894": "https://git.drupalcode.org/project/drupal/-/merge_requests/10628.diff",
                "Add missing enclosure to Views RSS https://www.drupal.org/node/2511878": "https://www.drupal.org/files/issues/2026-08-10/drupal-core-2511878-95_0.patch",
                "Views Term ID has broken filters (\"All of\", \"Is none of\") and contextual filters \"allow multiple\" https://www.drupal.org/project/drupal/issues/2829178": "https://git.drupalcode.org/project/drupal/-/merge_requests/5321.patch",
                "More link is missing in pager when using the \"Some\" pager and there are more records than shown https://www.drupal.org/project/drupal/issues/3381979": "https://www.drupal.org/files/issues/2025-06-25/3381979-more-link-is-missing-in-some-pager-when-there-are-more-records-than-shown-d11.2.0-rc2.patch",
                "Background colour of UI widgets get overridden on Ajax load. https://www.drupal.org/project/drupal/issues/3383631": "https://git.drupalcode.org/project/drupal/-/merge_requests/13775.diff"
            },
            "drupal/config_partial_export": {
                "Support config download based on collection https://www.drupal.org/project/config_partial_export/issues/3439357": "https://git.drupalcode.org/project/config_partial_export/-/merge_requests/6.diff"
            },
            "drupal/content_snippets": {
                "Error: Cannot unset string offsets... https://www.drupal.org/project/content_snippets/issues/3268757": "https://git.drupalcode.org/issue/content_snippets-3268757/-/merge_requests/1.diff"
            },
            "drupal/diff": {
                "No local tasks on compare revisions page https://www.drupal.org/project/diff/issues/2954352": "https://www.drupal.org/files/issues/2026-08-13/diff-add_local_tasks-2954352-34.patch"
            },
            "drupal/facets_pretty_paths": {
                "Space appended to url outputs error https://www.drupal.org/project/facets_pretty_paths/issues/3575306": "https://git.drupalcode.org/project/facets_pretty_paths/-/merge_requests/25.diff",
                "ViewPageController::$contextualLinks must not be accessed before initialization (Drupal 11) https://www.drupal.org/project/facets_pretty_paths/issues/3608564": "https://git.drupalcode.org/project/facets_pretty_paths/-/merge_requests/27.diff"
            },
            "drupal/focal_point": {
                "On re-positioning hash, only flush image styles that use Focal Point (s3 incompatibility) https://www.drupal.org/project/focal_point/issues/3585050": "https://git.drupalcode.org/project/focal_point/-/merge_requests/56.diff"
            },
            "drupal/entity_embed": {
                "Logs flooded with warning messages 'Invalid display settings encountered' https://www.drupal.org/project/entity_embed/issues/3077225": "https://www.drupal.org/files/issues/2019-12-11/3077225-10.reduce-invalid-config-logs.patch",
                "Entity embed dialog can no longer use custom data- attributes in CKEditor 5 https://www.drupal.org/project/entity_embed/issues/3410132": "https://www.drupal.org/files/issues/2025-08-07/3410132-MR-31_support-custom-data-attribs.diff-14.patch",
                "SEE README.md in patch folder. Drupal 10.5/11.2 compatability (tooltip broken, cannot edit embedded entities) https://www.drupal.org/project/entity_embed/issues/3531672": "https://raw.githubusercontent.com/wri/wri_sites/refs/heads/main/patches/entity_embed--fix-ckeditor-icon-reference--3531672.patch"
            },
            "drupal/entity_share": {
                "Call to a member function hasField() on null in SkipImported https://www.drupal.org/project/entity_share/issues/3569090": "https://git.drupalcode.org/project/entity_share/-/merge_requests/165.diff",
                "Layout Builder import patch: https://www.drupal.org/project/entity_share/issues/3084184": "https://git.drupalcode.org/project/entity_share/-/merge_requests/96.diff?v=1",
                "Paragraphs parent IDs are wrong https://www.drupal.org/project/entity_share/issues/3445703": "https://www.drupal.org/files/issues/2024-05-08/entity_share-parent-id-3445703-2.patch",
                "Remove canonical link templates that have no route (list builders 500 on Drupal 11) https://www.drupal.org/project/entity_share/issues/3419256": "https://git.drupalcode.org/project/entity_share/-/merge_requests/89.diff"
            },
            "drupal/layout_builder_st": {
                "Nontranslatable custom block fields are not synchronized between translations https://www.drupal.org/project/layout_builder_st/issues/3108061 (MR !33 without its tests hunk, which no longer applies to 2.0.0)": "https://raw.githubusercontent.com/wri/wri_sites/refs/heads/624-d11-upgrade/patches/layout_builder_st--nontranslatable-block-fields-sync--3108061-mr33-without-tests.patch"
            },
            "drupal/metatag": {
                "Provide field formatter to output meta tags on-page, e.g. for use with Views (D9), https://www.drupal.org/project/metatag/issues/3027873": "https://www.drupal.org/files/issues/2023-07-23/metatag-field_formatter_for_views-3027873-27.patch",
                "Add option to allow Custom Tags to control multiple property https://www.drupal.org/project/metatag/issues/3561350": "https://git.drupalcode.org/project/metatag/-/merge_requests/249.diff"
            },
            "drupal/schema_metatag": {
                "allow more characters in \"sameAs\" field? or convert to multivalue single fields? https://www.drupal.org/project/schema_metatag/issues/3498969": "https://git.drupalcode.org/project/schema_metatag/-/merge_requests/90.diff?v=3.1.x"
            },
            "drupal/oembed_lazyload": {
                "Use strict should be inside function https://www.drupal.org/project/oembed_lazyload/issues/3475956#comment-16067120": "https://www.drupal.org/files/issues/2024-09-21/oembed_lazyload_use_strict-3475956.patch"
            },
            "drupal/paragraphs": {
                "Add a parent entity token for paragraphs https://www.drupal.org/project/paragraphs/issues/3067265": "https://www.drupal.org/files/issues/2026-06-24/3084934-13_combine_3090200-22-rebase.patch"
            },
            "drupal/redirect": {
                "RouteNormalizerRequestSubscriber doesn't handle encoded urls https://www.drupal.org/project/redirect/issues/3067438": "https://git.drupalcode.org/project/redirect/-/merge_requests/206.diff"
            },
            "drupal/rest_api_authentication": {
                "MISSING_AUTHORIZATION_HEADER on batch https://www.drupal.org/project/rest_api_authentication/issues/3517729": "https://www.drupal.org/files/issues/2026-09-24/rest_api_authentication-3517729-5.patch"
            },
            "drupal/token": {
                "Add a [current-page:object:?] dynamic token https://www.drupal.org/project/token/issues/919760": "https://www.drupal.org/files/issues/2026-08-18/token-current_page_object_tokens-919760-118.patch",
                "Provide array of primitive property values on multivalue field https://www.drupal.org/project/token/issues/3115486": "https://git.drupalcode.org/project/token/-/merge_requests/114.diff"
            },
            "drupal/views_bulk_edit": {
                "Fix Required fields to really not be required https://www.drupal.org/node/3024419": "https://www.drupal.org/files/issues/2024-01-10/views_bulk_edit-3024419-fix_required_fields-57.patch"
            },
            "drupal/viewfield": {
                "View title is HTML-double-encoded when shown via the field label (e.g. &amp; becomes &amp;amp;) https://www.drupal.org/project/viewfield/issues/3619319": "https://git.drupalcode.org/project/viewfield/-/merge_requests/26.diff"
            },
            "drupal/views_extras": {
                "Why does Views Extras require Drupal_Visitors to be part of the cookie name? https://www.drupal.org/project/views_extras/issues/3054202" : "https://www.drupal.org/files/issues/2024-01-03/3054202-11.patch",
                "Automated Drupal 11 compatibility fixes https://www.drupal.org/project/views_extras/issues/3435460 (committed to 3.x, not released)": "https://git.drupalcode.org/project/views_extras/-/commit/357d342dc3b44d7993b61f2c2f0e98919dcce84f.diff"
            },
            "drupal/entity_share_cron": {
                "Drupal 11 compatibility https://www.drupal.org/project/entity_share_cron/issues/3430244 (bot MR !13 targets 3.0.x-dev and does not apply to 3.0.2)": "https://raw.githubusercontent.com/wri/wri_sites/refs/heads/624-d11-upgrade/patches/entity_share_cron--d11-compatibility.patch"
            },
            "drupal/layout_builder_modal": {
                "incompatibility with layout_builder_st, contextual links broken https://www.drupal.org/project/layout_builder_modal/issues/3133695": "https://www.drupal.org/files/issues/2022-12-15/3133695-13.patch"
            },
            "drupal/webform": {
                "[Webform 6.2.3] Element autocomplete does not validate against list of options https://www.drupal.org/project/webform/issues/3463864": "https://git.drupalcode.org/project/webform/-/merge_requests/493.diff?date=2024-07-16"
            }
        },
        "drupal-scaffold": {
            "locations": {
                "project-root": "./web",
                "web-root": "./web"
            },
            "file-mapping": {
                "[project-root]/core-module-update.sh": ".ci/core-module-update.sh"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/private/scripts/quicksilver/{$name}/": [
                "type:quicksilver-script"
            ]
        }
    },
