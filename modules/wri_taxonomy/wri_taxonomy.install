/**
 * Generates the term-level resource library CTA block.
 */
function wri_taxonomy_update_10604() {
  $moduleHandler = \Drupal::service('module_handler');
  if (!$moduleHandler->moduleExists('wri_looking_terms')) {
    \Drupal::service('module_installer')->install(['wri_looking_terms'], TRUE);
  }

  _wri_taxonomy_force_block_id(
    '81846b54-79dc-4910-9d5c-177a54e695fb',
    102,
    [
      'uuid' => '81846b54-79dc-4910-9d5c-177a54e695fb',
      'type' => 'looking_for_something_specific',
      'info' => 'Looking for something specific',
      'langcode' => 'en',
      'reusable' => FALSE,
      'field_title' => 'Looking for something specific?',
      'field_intro' => [
        'value' => '<p>WRI works on multiple topics within [current-page:taxonomy_term:name]. To view and filter all [current-page:taxonomy_term:name] resources, explore our <a href="[wri_tokens:resources_anchor]">Resource Library Below</a>.</p>',
        'format' => 'basic_html',
      ],
      'field_explore_more' => [
        'value' => 'Explore more topics within [current-page:taxonomy_term:name]',
        'format' => 'basic_html',
      ],
      'field_listing' => [
        'target_id' => 'child_topics',
        'display_id' => 'child_topics_block',
        'arguments' => '[current-page:taxonomy_term:tid]',
        'items_to_display' => '',
        'token_help' => '',
      ],
    ]
  );
}

/**
 * Adds intro text to the term-level webform block and hides it from visitors.
 */
function wri_taxonomy_update_10605() {
  // Updates run before config import, so install the fields first.
  $updates = \Drupal::service('distro_helper.updates');
  $updates->installConfig('field.storage.block_content.field_hidden_from_visitors', 'wri_webform_block');
  $updates->installConfig('field.field.block_content.webform_with_background_color.field_intro', 'wri_webform_block');
  $updates->installConfig('field.field.block_content.webform_with_background_color.field_hidden_from_visitors', 'wri_webform_block');

  $blocks = \Drupal::entityTypeManager()->getStorage('block_content')->loadByProperties([
    'uuid' => 'c2faf277-9cee-48bd-9f70-09ee7613806a',
  ]);
  $block = $blocks ? reset($blocks) : NULL;
  if ($block) {
    $block->set('field_intro', [
      'value' => '<p>Get the latest research, events, and insights on [current-page:taxonomy_term:name] delivered to your inbox.</p>',
      'format' => 'basic_html',
    ]);
    $block->set('field_hidden_from_visitors', 1);
    $block->save();
  }
}

/**
 * Ensures a block_content entity exists with a fixed revision_id.
 */
function _wri_taxonomy_force_block_id($uuid, $id, array $values) {
  $block_manager = \Drupal::entityTypeManager()->getStorage('block_content');
  $blocks = $block_manager->loadByProperties(['uuid' => $uuid]);
  $block = $blocks ? reset($blocks) : NULL;

  if (!$block) {
    $block = BlockContent::create(['revision_id' => $id] + $values);
    $block->save();
  }
}
