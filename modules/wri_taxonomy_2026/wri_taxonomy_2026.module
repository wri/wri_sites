<?php

/**
 * @file
 * Contains wri_taxonomy_2026.module.
 */

use Drupal\views\ViewExecutable;
use Drupal\views\Views;

/**
 * Implements hook_views_pre_render().
 */
function wri_taxonomy_2026_views_pre_render(ViewExecutable $view) {
  // Display => its selected-items attachment, keyed by view.
  $selected_displays = [
    'term_featured_items' => [
      'featured_projects' => 'featured_projects_selected',
      'featured_resources' => 'featured_resources_selected',
    ],
    // The fallbacks render via upcoming_featured's empty area, so trim them
    // against the same attachment.
    'featured_events' => [
      'upcoming_featured' => 'upcoming_featured_selected',
      'upcoming_fallback' => 'upcoming_featured_selected',
      'past_featured' => 'upcoming_featured_selected',
    ],
  ];
  $selected_display = $selected_displays[$view->id()][$view->current_display] ?? NULL;
  if (!$selected_display) {
    return;
  }
  // The selected-items attachment shares this display's item limit. Trim
  // here rather than in post_execute: viewfield hides the block if the main
  // result is empty before render.
  $selected = Views::getView($view->id());
  $selected->setArguments($view->args);
  $selected->setDisplay($selected_display);
  $selected->execute();
  $remaining = max(0, $view->getItemsPerPage() - count($selected->result));
  $view->result = array_slice($view->result, 0, $remaining);
}
