<?php

/**
 * @file
 * Install and update functions for wri_taxonomy_2026.
 */

/**
 * Implements hook_install().
 */
function wri_taxonomy_2026_install() {
  _wri_taxonomy_2026_ensure_featured_term();
}

/**
 * Show selected projects ahead of featured ones in term project listings.
 */
function wri_taxonomy_2026_update_11001() {
  $updates = \Drupal::service('distro_helper.updates');
  $updates->updateConfig('views.view.term_featured_items', [
    'display#featured_projects#display_options#arguments',
    'display#featured_projects_selected',
  ], 'wri_taxonomy_2026');

  _wri_taxonomy_2026_always_build_listing('field_project_listing');
}

/**
 * Limit Featured Resources on tags and topics to content tagged with the term.
 */
function wri_taxonomy_2026_update_11002() {
  $updates = \Drupal::service('distro_helper.updates');
  foreach (['tags', 'topics_and_subtopics'] as $bundle) {
    $updates->updateConfig("field.field.taxonomy_term.$bundle.field_featured_related_resources", [
      'dependencies',
      'settings',
    ], 'wri_taxonomy_2026');
  }
}

/**
 * Show selected resources ahead of featured ones in term resource listings.
 */
function wri_taxonomy_2026_update_11003() {
  \Drupal::service('distro_helper.updates')->updateConfig('views.view.term_featured_items', [
    'display#featured_resources#display_options#arguments',
    'display#featured_resources_selected',
  ], 'wri_taxonomy_2026');
  _wri_taxonomy_2026_always_build_listing('field_resources_listing');
}

/**
 * Create the "Featured" term that featured listings look up by name.
 */
function wri_taxonomy_2026_update_11004() {
  _wri_taxonomy_2026_ensure_featured_term();
}

/**
 * Build term event listings even when only selected events have results.
 */
function wri_taxonomy_2026_update_11005() {
  _wri_taxonomy_2026_always_build_listing('field_event_listing');
}

/**
 * Creates the "Featured" term in the featured vocabulary if it is missing.
 */
function _wri_taxonomy_2026_ensure_featured_term() {
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  // Views match the name case-insensitively, so do the same here.
  $existing = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('vid', 'featured')
    ->condition('name', 'featured', 'LIKE')
    ->count()
    ->execute();
  if (!$existing) {
    $storage->create(['vid' => 'featured', 'name' => 'Featured'])->save();
  }
}

/**
 * Set always_build_output to true for blocks placed on taxonomy terms.
 */
function _wri_taxonomy_2026_always_build_listing(string $field_name) {
  $updates = \Drupal::service('distro_helper.updates');
  // The block template still hides it when nothing renders.
  foreach (['tags', 'regions', 'topics_and_subtopics'] as $bundle) {
    $name = "core.entity_view_display.taxonomy_term.$bundle.default";
    $config = \Drupal::configFactory()->getEditable($name);
    if ($config->isNew()) {
      continue;
    }
    $sections = $config->get('third_party_settings.layout_builder.sections') ?? [];
    foreach ($sections as $s => $section) {
      foreach ($section['components'] as $c => $component) {
        // Matched by plugin ID since component positions vary per site.
        if ($component['configuration']['id'] === "field_block:taxonomy_term:$bundle:$field_name") {
          $sections[$s]['components'][$c]['configuration']['formatter']['settings']['always_build_output'] = TRUE;
        }
      }
    }
    $config->set('third_party_settings.layout_builder.sections', $sections)->save();
    $updates->exportConfig($name);
  }
}
