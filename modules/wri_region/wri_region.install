<?php

/**
 * @file
 * Update hooks for wri_region.
 */

/**
 * Update the metatags to display field_intro for description.
 */
function wri_region_update_10001() {
  \Drupal::service('distro_helper.updates')->updateConfig('metatag.metatag_defaults.node__region', [
    'tags#description',
  ], 'wri_region');

  $message = 'Add field_intro to metatags description';
  return $message;
}

/**
 * Updates config changed between main and HEAD.
 */
function wri_region_update_10002() {
  \Drupal::service('distro_helper.updates')->updateConfig('core.entity_view_display.node.region.card', [
    'third_party_settings#ds#regions#intro',
    'third_party_settings#ds#fields#dek_summary_fallback',
  ], 'wri_region', 'install');
  \Drupal::service('distro_helper.updates')->installConfig('field.field.taxonomy_term.regions.field_featured_experts', 'wri_region', 'install');
  \Drupal::service('distro_helper.updates')->installConfig('field.field.taxonomy_term.regions.field_featured_items', 'wri_region', 'install');
  \Drupal::service('distro_helper.updates')->installConfig('field.field.taxonomy_term.regions.field_featured_related_resources', 'wri_region', 'install');
  \Drupal::service('distro_helper.updates')->installConfig('field.field.taxonomy_term.regions.field_projects', 'wri_region', 'install');
  \Drupal::service('distro_helper.updates')->installConfig('field.field.taxonomy_term.regions.layout_builder__layout', 'wri_region', 'install');
}
