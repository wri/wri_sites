<?php

/**
 * @file
 * Happening Now install and update hooks.
 */

/**
 * Translatable field update.
 */
function wri_happening_now_update_10301() {
  \Drupal::service('distro_helper.updates')->updateConfig('field.field.block_content.hero.field_hero_type', [
    'translatable',
  ], 'wri_happening_now');
  \Drupal::service('distro_helper.updates')->updateConfig('field.field.paragraph.happening_now.field_listing', [
    'translatable',
  ], 'wri_happening_now');
}

/**
 * Updates config changed between main and HEAD.
 */
function wri_happening_now_update_10302() {
  \Drupal::service('distro_helper.updates')->updateConfig('field.field.paragraph.happening_now.field_custom_happening_nows', [
    'settings#handler_settings#view#arguments#0',
  ], 'wri_happening_now', 'install');
  \Drupal::service('distro_helper.updates')->updateConfig('views.view.happening_now', [
    'display#default#display_options#cache#type',
    'display#default#display_options#sorts#weight#argument_number',
  ], 'wri_happening_now', 'install');
}
