<?php

/**
 * @file
 * Install hooks for wri_megamenu_2026.
 */

/**
 * Implements hook_install().
 *
 * Hides every legacy block in the primary_nav/secondary_nav regions on
 * /testing-2026-menu, so the page only shows the new 2026 megamenu blocks.
 * Blocks that already have a request_path visibility condition keep their
 * existing pages and just get /testing-2026-menu appended (unless it's
 * already there) and negate set to TRUE; blocks with no request_path
 * condition get one created from scratch.
 */
function wri_megamenu_2026_install() {
  $testing_path = '/testing-2026-menu';
  $regions = ['primary_nav', 'secondary_nav'];
  $excluded_block_ids = [
    'donate_2026',
    'quicklinks_2026',
    'primary_nav',
    'ts_wrin_megamenu2026_2',
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('block');
  $ids = $storage->getQuery()
    ->condition('region', $regions, 'IN')
    ->accessCheck(FALSE)
    ->execute();

  /** @var \Drupal\block\BlockInterface $block */
  foreach ($storage->loadMultiple($ids) as $block) {
    if (in_array($block->id(), $excluded_block_ids, TRUE)) {
      continue;
    }

    if ($block->getVisibilityConditions()->has('request_path')) {
      $configuration = $block->getVisibilityCondition('request_path')->getConfiguration();
      $pages = (string) ($configuration['pages'] ?? '');
      $existing_paths = array_map('trim', preg_split('/\r\n|\r|\n/', $pages));

      if (!in_array($testing_path, $existing_paths, TRUE)) {
        $configuration['pages'] = $pages === '' ? $testing_path : $pages . "\r\n" . $testing_path;
      }
      $configuration['negate'] = TRUE;
    }
    else {
      $configuration = [
        'id' => 'request_path',
        'negate' => TRUE,
        'context_mapping' => [],
        'pages' => $testing_path,
      ];
    }

    $block->setVisibilityConfig('request_path', $configuration);
    $block->save();
  }
}
