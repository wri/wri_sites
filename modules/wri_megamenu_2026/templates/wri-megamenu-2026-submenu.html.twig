{#
/**
 * @file
 * Renders a mega menu submenu button plus its flyout panel.
 *
 * Replaces the markup that used to be hand-built in
 * paragraph--submenu--default.html.twig from menu_title/menu_uuid
 * variables computed in ts_wrin_preprocess_paragraph().
 *
 * The .menu-contents children (h3, .field--name-field-text,
 * .field--name-field-listing, the menu block) must stay direct children of
 * .menu-contents in this order: ts_megamenu.js and ts_megamenu_mobile.js
 * select them with :scope > selectors and move them into a generated grid.
 *
 * Available variables:
 * - title: The referenced menu item's title.
 * - text: Rendered field_text output from the paragraph (or NULL).
 * - listing: Rendered field_listing output from the paragraph (or NULL).
 * - menu_block: The built menu_block render array for the referenced menu
 *   item's children (or NULL).
 */
#}
<button>{{ title }}</button>
<div class="menu-contents">
  <h3>{{ title }}</h3>
  {{ text }}
  {{ listing }}
  {{ menu_block }}
</div>
