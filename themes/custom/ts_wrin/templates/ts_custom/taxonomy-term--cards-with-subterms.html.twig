{#
/**
 * @file
 * Theme override for the "Cards with subterms" taxonomy term view mode.
 *
 * Used for both Tags and Topics and Subtopics terms: as a slide in the
 * "Looking for something specific" block's Listing carousel, and nested one
 * level within a Topic's own card via its Related tags viewfield (there,
 * shown without the border/image treatment - see the
 * .cards-with-subterms-card override under .looking-terms-related-tags in
 * _looking-terms.scss).
 *
 * @see template_preprocess_taxonomy_term()
 */
#}
<div class="cards-with-subterms-card border border-solid border-neutral-900 p-[16px] h-full flex flex-col">
  <h3 class="h3 mb-[8px]">
    <a href="{{ url }}" class="text-neutral-900 no-underline">{{ name }}</a>
  </h3>
  <hr class="cards-with-subterms-card__rule border-t border-solid border-neutral-900 mb-[10px]">
  {% set intro = content.field_intro|render %}
  {% if intro|trim %}
    <div class="utility-base mb-[10px]">{{ intro }}</div>
  {% endif %}
  {% set image = content.field_main_image|render %}
  {% if image|trim %}
    <div class="cards-with-subterms-card__image mb-[10px]">{{ image }}</div>
  {% endif %}
  {% set related_tags = content.field_related_tags|render %}
  {% if related_tags|trim %}
    <div class="looking-terms-related-tags utility-base mb-[10px]">{{ related_tags }}</div>
  {% endif %}
  <div class="cards-with-subterms-card__link mt-auto pt-[4px]">
    {{ content.explore_all_link }}
  </div>
</div>
